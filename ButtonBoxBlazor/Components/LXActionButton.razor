<button class="grid-btn grid-item" style="@ButtonStyle" @onclick="OnClick">
    <span class="btn-icon" style="--icon-src:url('@Definition.Icon')"></span>
    <span class="btn-label">@((MarkupString)Definition.Label)</span>
</button>

@code {
    [Parameter, EditorRequired]
    public LXActionButtonDef Definition { get; set; } = null!;

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string ButtonStyle
    {
        get
        {
            var style = $"grid-row:{Definition.Row + 1}; grid-column:{Definition.Col + 1};";
            if (Definition.Color is { } color)
            {
                style += $"--btn-color:{color};";
            }
            return style;
        }
    }
}