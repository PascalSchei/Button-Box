@page "/settings"
@rendermode InteractiveServer
@implements IDisposable
@inject LayoutService Layout
@inject BlockOrderStore OrderStore
@inject ControlsStore Controls

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    @{
        var display = Layout.Display;
        var order = OrderStore.Order;

        <section>
            <h2>Grid</h2>
            <div class="settings-row">
                <label for="preset">Preset</label>
                <select id="preset" class="form-select" value="@CurrentPreset" @onchange="OnPresetChanged">
                    @foreach (var preset in GridPreset.All)
                    {
                        <option value="@preset.Name">@preset.Name (@preset.Cols x @preset.Rows)</option>
                    }
                    <option value="@CustomPreset">Custom</option>
                </select>
            </div>
            <div class="settings-row">
                <label for="cols">Columns (@GridPreset.MinCols-@GridPreset.MaxCols)</label>
                <input id="cols" type="number" class="form-control" min="@GridPreset.MinCols" max="@GridPreset.MaxCols" value="@Layout.Cols"
                       @onchange="e => SetGrid(e.Value, Layout.Rows)" />
            </div>
            <div class="settings-row">
                <label for="rows">Rows (@GridPreset.MinRows-@GridPreset.MaxRows)</label>
                <input id="rows" type="number" class="form-control" min="@GridPreset.MinRows" max="@GridPreset.MaxRows" value="@Layout.Rows"
                       @onchange="e => SetGrid(Layout.Cols, e.Value)" />
            </div>
            <p>Pages: @Layout.Pages.Count</p>
        </section>

        <section>
            <h2>Button display</h2>
            <label class="settings-check">
                <input type="checkbox" checked="@display.ShowIcon" disabled="@(display is { ShowIcon: true, ShowText: false, ShowKey: false })"
                       @onchange="e => SetDisplay(display with { ShowIcon = (bool)e.Value! })" /> Icon
            </label>
            <label class="settings-check">
                <input type="checkbox" checked="@display.ShowText" disabled="@(display is { ShowIcon: false, ShowText: true, ShowKey: false })"
                       @onchange="e => SetDisplay(display with { ShowText = (bool)e.Value! })" /> Text
            </label>
            <label class="settings-check">
                <input type="checkbox" checked="@display.ShowKey" disabled="@(display is { ShowIcon: false, ShowText: false, ShowKey: true })"
                       @onchange="e => SetDisplay(display with { ShowKey = (bool)e.Value! })" /> Key
            </label>
        </section>

        <section>
            <h2>Condor controls</h2>
            <div class="settings-row">
                <label for="controls-path">Path to controls.ini</label>
                <input id="controls-path" type="text" class="form-control" readonly value="@Controls.IniPath" placeholder="Not set: default keys" />
            </div>
            <button type="button" class="btn btn-primary" disabled="@_browsing" @onclick="BrowseControlsAsync">Browse...</button>
            <button type="button" class="btn btn-secondary" @onclick="SearchControls">Search</button>
            <button type="button" class="btn btn-secondary" disabled="@(Controls.IniPath is null)" @onclick="Controls.Reload">Reload</button>
            <button type="button" class="btn btn-secondary" disabled="@(Controls.IniPath is null)" @onclick="ClearControlsPath">Use default keys</button>
            @if (Controls.Status is { } status)
            {
                <p class="mt-2">@status</p>
            }
            @if (_controlsCandidates is { } candidates)
            {
                if (candidates.Count == 0)
                {
                    <p class="mt-2">No controls.ini found in Documents\Condor3\Pilots.</p>
                }
                foreach (var candidate in candidates)
                {
                    <div>
                        <button type="button" class="btn btn-secondary mt-1" @onclick="() => UseControlsCandidate(candidate)">@candidate</button>
                    </div>
                }
            }
            <p>Buttons use the keyboard keys bound in controls.ini; other buttons keep their default key. Applies to all devices.</p>
        </section>

        <section>
            <h2>Blocks</h2>
            <label class="settings-check">
                <input type="checkbox" checked="@Layout.ShowBlockOutline"
                       @onchange="e => Layout.SetBlockOutline((bool)e.Value!)" /> Show block outline
            </label>
            @for (var i = 0; i < order.Count; i++)
            {
                var block = BlockCatalog.ById[order[i]];
                var index = i;
                <div class="settings-block">
                    <label class="settings-check">
                        <input type="checkbox" checked="@Layout.IsSelected(block.Id)"
                               @onchange="e => Layout.SetBlockSelected(block.Id, (bool)e.Value!)" />
                        @block.Name (@block.Width x @block.Height)
                        @if (block.Width > Layout.Cols || block.Height > Layout.Rows)
                        {
                            <span class="text-warning">does not fit the grid</span>
                        }
                    </label>
                    <span class="settings-block-buttons">
                        <button type="button" class="btn btn-secondary" disabled="@(index == 0)" aria-label="Move @block.Name up"
                                @onclick="() => OrderStore.Move(block.Id, -1)">&uarr;</button>
                        <button type="button" class="btn btn-secondary" disabled="@(index == order.Count - 1)" aria-label="Move @block.Name down"
                                @onclick="() => OrderStore.Move(block.Id, 1)">&darr;</button>
                    </span>
                </div>
            }
        </section>
    }
</div>

@code {
    private const string CustomPreset = "custom";

    private string CurrentPreset =>
        GridPreset.All.FirstOrDefault(p => p.Cols == Layout.Cols && p.Rows == Layout.Rows)?.Name ?? CustomPreset;

    private bool _browsing;
    private IReadOnlyList<string>? _controlsCandidates;

    protected override void OnInitialized() => Layout.Changed += OnLayoutChanged;

    // The dialog opens on the machine running the server.
    private async Task BrowseControlsAsync()
    {
        _browsing = true;
        try
        {
            if (await IniFileDialog.PickAsync(Controls.SuggestedFolder()) is { } path)
            {
                _controlsCandidates = null;
                Controls.SetPath(path);
            }
        }
        finally
        {
            _browsing = false;
        }
    }

    private void ClearControlsPath() => Controls.SetPath(null);

    private void SearchControls() => _controlsCandidates = Controls.FindCandidates();

    private void UseControlsCandidate(string path)
    {
        _controlsCandidates = null;
        Controls.SetPath(path);
    }

    private void OnPresetChanged(ChangeEventArgs e)
    {
        if (GridPreset.All.FirstOrDefault(p => p.Name == e.Value as string) is { } preset)
        {
            Layout.SetGrid(preset.Cols, preset.Rows);
        }
    }

    private void SetGrid(object? cols, object? rows)
    {
        if (int.TryParse(cols?.ToString(), out var c) && int.TryParse(rows?.ToString(), out var r))
        {
            Layout.SetGrid(c, r);
        }
    }

    private void SetDisplay(ButtonDisplay display) => Layout.SetDisplay(display);

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Layout.Changed -= OnLayoutChanged;
}
