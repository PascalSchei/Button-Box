@page "/settings"
@rendermode InteractiveServer
@implements IDisposable
@inject LayoutService Layout
@inject BlockOrderStore OrderStore
@inject PageBreakStore PageBreaks
@inject ControlsStore Controls
@inject LayoutSettingsStore LayoutSettings
@inject NetworkSettingsStore Network

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    @{
        var display = Layout.Display;
        var order = OrderStore.Order;

        <section>
            <h2>Grid</h2>
            <div class="settings-row">
                <label for="preset">Preset</label>
                <select id="preset" class="form-select" value="@CurrentPreset" @onchange="OnPresetChanged">
                    @foreach (var preset in GridPreset.All)
                    {
                        <option value="@preset.Name">@preset.Name (@preset.Cols x @preset.Rows)</option>
                    }
                    <option value="@CustomPreset">Custom</option>
                </select>
            </div>
            <div class="settings-row">
                <label for="cols">Columns (@GridPreset.MinCols-@GridPreset.MaxCols)</label>
                <input id="cols" type="number" class="form-control" min="@GridPreset.MinCols" max="@GridPreset.MaxCols" value="@Layout.Cols"
                       @onchange="e => SetGrid(e.Value, Layout.Rows)" />
            </div>
            <div class="settings-row">
                <label for="rows">Rows (@GridPreset.MinRows-@GridPreset.MaxRows)</label>
                <input id="rows" type="number" class="form-control" min="@GridPreset.MinRows" max="@GridPreset.MaxRows" value="@Layout.Rows"
                       @onchange="e => SetGrid(Layout.Cols, e.Value)" />
            </div>
            <p>Pages: @Layout.Pages.Count</p>
        </section>

        <section>
            <h2>Button display</h2>
            <label class="settings-check">
                <input type="checkbox" checked="@display.ShowIcon" disabled="@(display is { ShowIcon: true, ShowText: false, ShowKey: false })"
                       @onchange="e => SetDisplay(display with { ShowIcon = (bool)e.Value! })" /> Icon
            </label>
            <label class="settings-check">
                <input type="checkbox" checked="@display.ShowText" disabled="@(display is { ShowIcon: false, ShowText: true, ShowKey: false })"
                       @onchange="e => SetDisplay(display with { ShowText = (bool)e.Value! })" /> Text
            </label>
            <label class="settings-check">
                <input type="checkbox" checked="@display.ShowKey" disabled="@(display is { ShowIcon: false, ShowText: false, ShowKey: true })"
                       @onchange="e => SetDisplay(display with { ShowKey = (bool)e.Value! })" /> Key
            </label>
        </section>

        <section>
            <h2>Condor controls</h2>
            <div class="settings-row">
                <label for="controls-path">Path to controls.ini</label>
                <input id="controls-path" type="text" class="form-control" readonly value="@Controls.IniPath" placeholder="Not set: default keys" />
            </div>
            <button type="button" class="btn btn-primary" disabled="@_browsing" @onclick="BrowseControlsAsync">Browse...</button>
            <button type="button" class="btn btn-secondary" @onclick="SearchControls">Search</button>
            <button type="button" class="btn btn-secondary" disabled="@(Controls.IniPath is null)" @onclick="Controls.Reload">Reload</button>
            <button type="button" class="btn btn-secondary" disabled="@(Controls.IniPath is null)" @onclick="ClearControlsPath">Use default keys</button>
            @if (Controls.Status is { } status)
            {
                <p class="mt-2">@status</p>
            }
            @if (_controlsCandidates is { } candidates)
            {
                if (candidates.Count == 0)
                {
                    <p class="mt-2">No controls.ini found in Documents\Condor3\Pilots.</p>
                }
                foreach (var candidate in candidates)
                {
                    <div>
                        <button type="button" class="btn btn-secondary mt-1" @onclick="() => UseControlsCandidate(candidate)">@candidate</button>
                    </div>
                }
            }
            <p>Buttons use the keyboard keys bound in controls.ini; other buttons keep their default key. Applies to all devices.</p>
        </section>

        <section>
            <h2>Blocks</h2>
            <label class="settings-check">
                <input type="checkbox" checked="@Layout.ShowBlockOutline"
                       @onchange="e => Layout.SetBlockOutline((bool)e.Value!)" /> Show block outline
            </label>
            @{
                var settingsPageIndex = -1;
            }
            @for (var i = 0; i <= order.Count; i++)
            {
                var index = i;
                @foreach (var layoutPage in Layout.Pages.Where(candidate => (candidate.BreakPosition ?? candidate.StartOrderIndex) == index))
                {
                    var position = layoutPage.BreakPosition ?? layoutPage.StartOrderIndex;
                    var isFirstPage = layoutPage == Layout.Pages[0];
                    var pageKey = layoutPage.BreakId ?? $"auto-{position}";
                    settingsPageIndex++;
                    <div class="settings-page-break @(settingsPageIndex % 2 == 0 ? "settings-page-light" : "settings-page-dark")" @key="pageKey">
                        <span class="settings-page-break-label">@layoutPage.Name</span>
                        @if (PageBreaks.IsCustomized(position, layoutPage.BreakId))
                        {
                            <input type="text" class="form-control settings-page-name" value="@layoutPage.Name" maxlength="60" aria-label="Page name"
                                   @onchange="e => PageBreaks.Rename(position, e.Value?.ToString(), layoutPage.BreakId)" />
                        }
                        <span class="settings-block-buttons">
                            <button type="button" class="btn btn-secondary" @onclick="() => PageBreaks.AddAfter(position, layoutPage.BreakId)">Add Page</button>
                            <button type="button" class="btn btn-secondary" disabled="@(isFirstPage || !PageBreaks.CanMove(position, -1, layoutPage.BreakId))" aria-label="Move @layoutPage.Name up"
                                    @onclick="() => PageBreaks.Move(position, -1, layoutPage.BreakId)">&uarr;</button>
                            <button type="button" class="btn btn-secondary" disabled="@(isFirstPage || !PageBreaks.CanMove(position, 1, layoutPage.BreakId))" aria-label="Move @layoutPage.Name down"
                                    @onclick="() => PageBreaks.Move(position, 1, layoutPage.BreakId)">&darr;</button>
                            @if (PageBreaks.IsCustomized(position, layoutPage.BreakId))
                            {
                                <button type="button" class="btn btn-danger"
                                        aria-label="@(isFirstPage ? $"Reset customization {layoutPage.Name}" : $"Delete page break {layoutPage.Name}")"
                                        @onclick="() => PageBreaks.Delete(position, layoutPage.BreakId)">Delete</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary" @onclick="() => PageBreaks.EnsureBreak(position, layoutPage.BreakId)">Customize</button>
                            }
                        </span>
                    </div>
                }
                @if (index < order.Count)
                {
                    var block = BlockCatalog.ById[order[index]];
                    <div class="settings-block @(settingsPageIndex < 0 ? "" : settingsPageIndex % 2 == 0 ? "settings-page-light" : "settings-page-dark")">
                        <label class="settings-check">
                            <input type="checkbox" checked="@Layout.IsSelected(block.Id)"
                                   @onchange="e => Layout.SetBlockSelected(block.Id, (bool)e.Value!)" />
                            @block.Name (@block.Width x @block.Height)
                            @if (block.Width > Layout.Cols || block.Height > Layout.Rows)
                            {
                                <span class="text-warning">does not fit the grid</span>
                            }
                        </label>
                        <span class="settings-block-buttons">
                            <button type="button" class="btn btn-secondary" disabled="@(!Layout.CanMoveBlock(block.Id, -1))" aria-label="Move @block.Name up"
                                    @onclick="() => Layout.MoveBlock(block.Id, -1)">&uarr;</button>
                            <button type="button" class="btn btn-secondary" disabled="@(!Layout.CanMoveBlock(block.Id, 1))" aria-label="Move @block.Name down"
                                    @onclick="() => Layout.MoveBlock(block.Id, 1)">&darr;</button>
                        </span>
                    </div>
                }
            }
        </section>

        <section>
            <h2>Network</h2>
            <div class="settings-row settings-action">
                @if (Network.AllowAllNetworks)
                {
                    <button type="button" class="btn btn-secondary" @onclick="() => Network.SetAllowAllNetworks(false)">Local networks only</button>
                    <div>
                        <p class="text-warning" role="alert">All networks are allowed. Anyone who can reach this PC on port 54738 can press keys on it.</p>
                    </div>
                }
                else
                {
                    <button type="button" class="btn btn-danger" disabled="@_confirmAllowAll" @onclick="() => _confirmAllowAll = true">Allow all networks</button>
                    <div>
                        <p>Only devices in your local network (home Wi-Fi, LAN, phone hotspot) can connect. Allow all networks if you connect through a VPN such as Tailscale and get 403 Forbidden.</p>
                        @if (_confirmAllowAll)
                        {
                            <p class="text-warning" role="alert">Warning: Button Box has no password. With all networks allowed, anyone who can reach this PC, for example from the internet through a forwarded port, can press keys on it. Only enable this in a network you trust.</p>
                            <button type="button" class="btn btn-danger" @onclick="ConfirmAllowAll">Allow all networks</button>
                            <button type="button" class="btn btn-secondary" @onclick="() => _confirmAllowAll = false">Cancel</button>
                        }
                    </div>
                }
            </div>
        </section>

        <section>
            <h2>Reset</h2>
            <div class="settings-row settings-action">
                <button type="button" class="btn btn-danger" disabled="@(_browsing || _confirmReset)" @onclick="RequestReset">Reset</button>
                <div>
                    <p>Restore default settings for all devices, including grid, display, blocks, page breaks, page names, the controls.ini path and the network setting. The controls.ini file itself is not changed.</p>
                    @if (_confirmReset)
                    {
                        <p role="alert">Reset all settings? This cannot be undone.</p>
                        <button type="button" class="btn btn-danger" disabled="@_browsing" @onclick="ResetSettings">Reset all settings</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => _confirmReset = false">Cancel</button>
                    }
                    @if (_resetError is not null)
                    {
                        <p class="text-danger mt-2" role="alert">@_resetError</p>
                    }
                    @if (_resetCompleted)
                    {
                        <p class="mt-2" role="status">All settings have been reset to defaults.</p>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    private const string CustomPreset = "custom";

    private string CurrentPreset =>
        GridPreset.All.FirstOrDefault(p => p.Cols == Layout.Cols && p.Rows == Layout.Rows)?.Name ?? CustomPreset;

    private bool _browsing;
    private IReadOnlyList<string>? _controlsCandidates;
    private bool _confirmReset;
    private bool _confirmAllowAll;
    private bool _resetCompleted;
    private string? _resetError;

    private void ConfirmAllowAll()
    {
        _confirmAllowAll = false;
        Network.SetAllowAllNetworks(true);
    }

    private void RequestReset()
    {
        _confirmReset = true;
        _resetCompleted = false;
        _resetError = null;
    }

    private void ResetSettings()
    {
        _resetError = null;
        _resetCompleted = false;
        try
        {
            PageBreaks.Reset();
            OrderStore.Reset();
            LayoutSettings.Reset();
            Controls.Reset();
            Network.Reset();
            _controlsCandidates = null;
            _confirmReset = false;
            _resetCompleted = true;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _resetError = "Some settings could not be reset. Changes already applied remain in effect. Check the server log and try again.";
        }
    }

    protected override void OnInitialized()
    {
        Layout.Changed += OnLayoutChanged;
        Network.Changed += OnLayoutChanged;
    }

    // The dialog opens on the machine running the server.
    private async Task BrowseControlsAsync()
    {
        _browsing = true;
        try
        {
            if (await IniFileDialog.PickAsync(Controls.SuggestedFolder()) is { } path)
            {
                _controlsCandidates = null;
                Controls.SetPath(path);
            }
        }
        finally
        {
            _browsing = false;
        }
    }

    private void ClearControlsPath() => Controls.SetPath(null);

    private void SearchControls() => _controlsCandidates = Controls.FindCandidates();

    private void UseControlsCandidate(string path)
    {
        _controlsCandidates = null;
        Controls.SetPath(path);
    }

    private void OnPresetChanged(ChangeEventArgs e)
    {
        if (GridPreset.All.FirstOrDefault(p => p.Name == e.Value as string) is { } preset)
        {
            Layout.SetGrid(preset.Cols, preset.Rows);
        }
    }

    private void SetGrid(object? cols, object? rows)
    {
        if (int.TryParse(cols?.ToString(), out var c) && int.TryParse(rows?.ToString(), out var r))
        {
            Layout.SetGrid(c, r);
        }
    }

    private void SetDisplay(ButtonDisplay display) => Layout.SetDisplay(display);

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Layout.Changed -= OnLayoutChanged;
        Network.Changed -= OnLayoutChanged;
    }
}
