@page "/lxcontrols"
@rendermode InteractiveServer
@using System.Globalization
@inject WindowTransparencyService Transparency

<PageTitle>LX Controls</PageTitle>

<ButtonGrid Buttons="Buttons">
    @foreach (var tile in InfoTiles)
    {
        <InfoTile Definition="tile" />
    }
    @foreach (var button in OpacityButtons)
    {
        <LXActionButton Definition="button" OnClick="() => Change(button.Delta)" />
    }
    <OpacityInfoTile Row="5" Col="2" Value="opacity" Error="error" />
</ButtonGrid>

@code {
    private const int Step = 10;

    private int? opacity;
    private string? error;

    private void Change(int delta)
    {
        (opacity, error) = Transparency.ChangeOpacity(delta);
    }

    private static readonly LXActionButtonDef[] OpacityButtons =
    [
        new(5, 0, "LX less visible", "icons/minus.svg", -Step),
        new(5, 1, "LX - more visible", "icons/plus.svg", Step)
    ];

    private static readonly InfoTileDef[] InfoTiles =
    [
        new(0, 3, "Time", t => TimeSpan.FromHours(t.Time % 24).ToString(@"hh\:mm\:ss")),
        new(1, 4, "MacCready m/s", t => t.MacCready.ToString("F2", CultureInfo.InvariantCulture), Color: "deepskyblue"),
        new InfoTileDef(1, 3, "Water", t => t.Water.ToString("F0", CultureInfo.InvariantCulture) + " kg")
    ];

    private static readonly ButtonDef[] Buttons =
    [
        new(0, 1, "NumPad8", "LX-Stick up", "Num 8", "icons/arrow-up.svg"),
        new(0, 0, "NumPad7", "Previous mode", "Num 7", "icons/arrow-double-left.svg", Color: "gold"),
        new(1, 0, "NumPad4", "LX-Stick left<br>Zoom out", "Num 4", "icons/arrow-left.svg"),
        new(1, 1, "NumPad5", "OK", "Num 5", "icons/ok-circle.svg", Color: "limegreen"),
        new(2, 1, "NumPad2", "LX-Stick down", "Num 2", "icons/arrow-down.svg"),
        new(1, 2, "NumPad6", "LX-Stick right<br>Zoom in", "Num 6", "icons/arrow-right.svg"),
        new(2, 2, "NumPad3", "Abort", "Num 3", "icons/abort-cross.svg", Color: "red"),
        new(0, 2, "NumPad9", "Next mode", "Num 9", "icons/arrow-double-right.svg", Color: "gold"),
        new(3, 4, "Prior", "Info Next<br>Turnpoint", "Page Up", "icons/arrow-triangle-up.svg"),
        new(4, 4, "Next", "Info Previous<br>Turnpoint", "Page Down", "icons/arrow-triangle-down.svg"),
        new(3, 3, "Slash", "Switch AAT<br>Turnpoint", "/", "icons/arrow-double-right.svg"),
        new(4, 3, "RightShift", "AAT-Turnpoint Shift On/Off", "Right Shift", "icons/arrow-four-way.svg"),
        new(0, 4, "Home", "Increase MacCready", "Home", "icons/arrow-triangle-up.svg", Mode: ButtonMode.Repeat, Color: "deepskyblue"),
        new(2, 4, "End", "Decrease MacCready", "End", "icons/arrow-triangle-down.svg", Mode: ButtonMode.Repeat, Color: "deepskyblue")
    ];
}