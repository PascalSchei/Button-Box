@page "/"
@page "/lxcontrols"
@rendermode InteractiveServer
@using System.Globalization
@inject WindowTransparencyService Transparency

<PageTitle>LX Controls</PageTitle>

<ButtonGrid Buttons="Buttons">
    @foreach (var tile in InfoTiles)
    {
        <InfoTile Definition="tile" />
    }
    @foreach (var button in OpacityButtons)
    {
        <LXActionButton Definition="button" OnClick="() => Change(button.Delta)" />
    }
    <OpacityInfoTile Row="1" Col="7" Value="opacity" Error="error" Color="gold" />
</ButtonGrid>

@code {
    private const int Step = 10;

    private int? opacity;
    private string? error;

    private void Change(int delta)
    {
        (opacity, error) = Transparency.ChangeOpacity(delta);
    }

    private static readonly LXActionButtonDef[] OpacityButtons =
    [
        new(2, 7, "LX less visible", "icons/minus.svg", -Step, "gold"),
        new(0, 7, "LX more visible", "icons/plus.svg", Step, "gold")
    ];

    private static readonly InfoTileDef[] InfoTiles =
    [
        new(0, 3, "Time", t => TimeSpan.FromHours(t.Time % 24).ToString(@"hh\:mm\:ss")),
        new(1, 6, "MacCready m/s", t => t.MacCready.ToString("F2", CultureInfo.InvariantCulture), Color: "gold"),
        new InfoTileDef(0, 4, "Water", t => t.Water.ToString("F0", CultureInfo.InvariantCulture) + " kg")
    ];

    private static readonly ButtonDef[] Buttons =
    [
        new(0, 1, "NumPad8", "LX-Stick up", "Num 8", "icons/arrow-up.svg"),
        new(0, 0, "NumPad7", "Previous mode", "Num 7", "icons/arrow-double-left.svg", Color: "white"),
        new(1, 0, "NumPad4", "LX-Stick left<br>Zoom out", "Num 4", "icons/arrow-left.svg"),
        new(1, 1, "NumPad5", "OK", "Num 5", "icons/ok-circle.svg", Color: "limegreen"),
        new(2, 1, "NumPad2", "LX-Stick down", "Num 2", "icons/arrow-down.svg"),
        new(1, 2, "NumPad6", "LX-Stick right<br>Zoom in", "Num 6", "icons/arrow-right.svg"),
        new(2, 2, "NumPad3", "Abort", "Num 3", "icons/abort-cross.svg", Color: "red"),
        new(0, 2, "NumPad9", "Next mode", "Num 9", "icons/arrow-double-right.svg", Color: "white"),
        new(1, 4, "Prior", "Info Next<br>Turnpoint", "Page Up", "icons/arrow-triangle-up.svg"),
        new(2, 4, "Next", "Info Previous<br>Turnpoint", "Page Down", "icons/arrow-triangle-down.svg"),
        new(1, 3, "Slash", "Switch AAT<br>Turnpoint", "/", "icons/arrow-double-right.svg"),
        new(2, 3, "RightShift", "AAT-Turnpoint Shift On/Off", "Right Shift", "icons/arrow-four-way.svg"),
        new(0, 6, "Home", "Increase MacCready", "Home", "icons/arrow-triangle-up.svg", Mode: ButtonMode.Repeat, Color: "gold"),
        new(2, 6, "End", "Decrease MacCready", "End", "icons/arrow-triangle-down.svg", Mode: ButtonMode.Repeat, Color: "gold"),

        // Altimeter / Vario block
        new(0, 8, "Equals", "Altimeter up", "=", "icons/arrow-triangle-up.svg", Mode: ButtonMode.Repeat, Color: "gold"),
        new(1, 8, "Minus", "Altimeter down", "-", "icons/arrow-triangle-down.svg", Mode: ButtonMode.Repeat, Color: "gold"),
        new(0, 9, "RightBracket", "Vario volume up", "]", "icons/arrow-triangle-up.svg", Mode: ButtonMode.Repeat, Color: "gold"),
        new(1, 9, "LeftBracket", "Vario volume down", "[", "icons/arrow-triangle-down.svg", Mode: ButtonMode.Repeat, Color: "gold"),
        new(2, 9, "RightCtrl", "Toggle<br>Climb / Cruise", "Right Ctrl", "icons/refresh.svg", Color: "gold"),

        // Blue buttons block
        new(5, 6, "R", "Release", "R", "icons/disconnect.svg", Color: "deepskyblue"),
        new(5, 7, "T", "Smoke", "T", "icons/air.svg", Color: "deepskyblue"),
        new(5, 8, "D0", "G Meter reset", "0", "icons/refresh.svg", Color: "deepskyblue"),
        new(5, 9, "E", "Check time", "E", "icons/time.svg", Color: "deepskyblue"),
        new(6, 6, "G", "Landing Gear", "G", "icons/wheel.svg", Color: "deepskyblue"),
        new(6, 7, "W", "Water", "W", "icons/drop.svg", Color: "deepskyblue"),
        new(6, 8, "Comma", "Bug wipers", ",", "icons/wiper.svg", Color: "deepskyblue"),
        new(6, 9, "LeftCtrl", "Swap controls", "Left Ctrl", "icons/swap.svg", Color: "deepskyblue"),

        // Esc/Pause/Flow block
        new(5, 0, "Escape", "Game menu", "Esc", "icons/menu.svg"),
        new(5, 1, "Shift", "Start flight", "Left Shift", "icons/start.svg", Color: "limegreen"),
        new(5, 2, "P", "Pause/Autopilot", "P", "icons/pause.svg"),

        // Chat block
        new(6, 0, "Backspace", "Send message", "Backspace", "icons/send.svg"),
        new(6, 1, "D", "Extend chat log", "D", "icons/chat.svg"),

        // Helpers block
        new(3, 8, "Q", "Miracle", "Q", "icons/miracle.svg", Color: "violet"),
        new(3, 9, "A", "Auto rudder toggle", "A", "icons/rudder.svg", Color: "violet"),
        new(4, 8, "H", "Lift helpers", "H", "icons/lift.svg", Color: "violet"),
        new(4, 9, "J", "Task helpers", "J", "icons/task.svg", Color: "violet")
    ];
}
