@page "/radio"
@rendermode InteractiveServer

<PageTitle>Radio</PageTitle>

<ButtonGrid Buttons="Buttons" />

@code {
    private static readonly ButtonDef[] Buttons =
    [
        new(0, 0, "Backslash", "Freq up", "\\", "icons/plus.svg", Mode: ButtonMode.Repeat),
        new(1, 0, "Quote", "Freq down", "'", "icons/minus.svg", Mode: ButtonMode.Repeat),
        new(0, 1, "D4", "Radio volume up", "4", "icons/plus.svg", Mode: ButtonMode.Repeat),
        new(1, 1, "D3", "Radio volume down", "3", "icons/minus.svg", Mode: ButtonMode.Repeat),
        new(0, 2, "D2", "Microphone volume up", "2", "icons/plus.svg", Mode: ButtonMode.Repeat),
        new(1, 2, "D1", "Microphone volume down", "1", "icons/minus.svg", Mode: ButtonMode.Repeat),
        new(3, 1, "Space", "Push To Talk", "Space", Color: "deepskyblue")
    ];
}
