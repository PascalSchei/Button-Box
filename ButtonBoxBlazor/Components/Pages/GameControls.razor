@page "/gamecontrols"
@rendermode InteractiveServer

<PageTitle>Game Controls</PageTitle>

<ButtonGrid Buttons="Buttons" />

@code {
    private static readonly ButtonDef[] Buttons =
    [
        // Airbrakes / Trimmer / Flaps block
        new(0, 8, "N", "AirBrakes up", "N", "icons/arrow-triangle-up.svg", Color: "orange"),
        new(1, 8, "B", "AirBrakes down", "B", "icons/arrow-triangle-down.svg", Color: "orange"),
        new(0, 6, "Delete", "Trimmer up", "Delete", "icons/arrow-triangle-up.svg", Color: "gold"),
        new(2, 6, "Insert", "Trimmer down", "Insert", "icons/arrow-triangle-down.svg", Color: "gold"),
        new(1, 6, "F12", "Trimmer center", "F12", "icons/ok-circle.svg", Color: "gold"),
        new(0, 7, "F", "Flaps up", "F", "icons/arrow-triangle-up.svg", Color: "gold"),
        new(1, 7, "V", "Flaps down", "V", "icons/arrow-triangle-down.svg", Color: "gold")
    ];
}
