@page "/condorstatus"
@rendermode InteractiveServer
@inherits TelemetryComponentBase
@using System.Globalization

<PageTitle>Condor Status</PageTitle>

<div class="condor-status">
    <span class="status-badge @(Connected ? "connected" : "disconnected")">
        @(Connected ? "Connected" : "Disconnected")
    </span>

    <ItemGrid Items="InfoTiles" />
</div>

@code {
    private static readonly InfoTileDef[] InfoTiles =
    [
        new(0, 0, "Time", t => t.Time.ToString("F2", CultureInfo.InvariantCulture) + " h"),
        new(0, 1, "Height (CG)", t => t.Height.ToString("F1", CultureInfo.InvariantCulture) + " m"),
        new(0, 2, "Wheel height", t => t.WheelHeight.ToString("F1", CultureInfo.InvariantCulture) + " m"),
        new(0, 3, "Flaps", t => t.Flaps.ToString("F0", CultureInfo.InvariantCulture)),
        new(0, 4, "MacCready", t => t.MacCready.ToString("F2", CultureInfo.InvariantCulture) + " m/s"),
        new(1, 0, "Water ballast", t => t.Water.ToString("F0", CultureInfo.InvariantCulture) + " kg"),
        new(1, 1, "HUD", t => t.HudMessages)
    ];

    private bool Connected => Telemetry.IsConnected;
}

