@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private IJSObjectReference? _wakeLockModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _wakeLockModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/wakeLock.js");
            await _wakeLockModule.InvokeVoidAsync("requestWakeLock");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // No interactive circuit yet, unsupported browser or insecure context - app works normally without a wake lock.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_wakeLockModule is null)
        {
            return;
        }

        try
        {
            await _wakeLockModule.InvokeVoidAsync("releaseWakeLock");
            await _wakeLockModule.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // Circuit already gone - nothing left to clean up.
        }
    }
}
