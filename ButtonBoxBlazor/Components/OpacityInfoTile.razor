<div class="grid-item info-tile" style="@TileStyle">
    <span class="info-value">@(Value is { } value ? $"{value} %" : "-")</span>
    <span class="btn-label">@(Error ?? Label)</span>
</div>

@code {
    [Parameter] public int Row { get; set; }
    [Parameter] public int Col { get; set; }
    [Parameter] public int? Value { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string Label { get; set; } = "LX opacity";
    [Parameter] public string Color { get; set; } = "violet";

    private string TileStyle => $"grid-row:{Row + 1}; grid-column:{Col + 1}; --btn-color:{Color}; color:var(--btn-color, white); background-color:color-mix(in srgb, var(--btn-color, black) 8%, black);";
}