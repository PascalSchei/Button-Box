<div class="button-grid @DisplayClass @(_outline.Length > 0 ? "has-block-outline" : "")" style="--cols:@Cols; --rows:@Rows;">
    <CascadingValue Value="Display">
        @foreach (var item in Items)
        {
            switch (item)
            {
                case ButtonDef button:
                    <KeyButton Definition="button" />
                    break;
                case InfoTileDef tile:
                    <InfoTile Definition="tile" />
                    break;
                case OpacityButtonDef action:
                    <OpacityButton Definition="action" />
                    break;
                case OpacityInfoTileDef opacityTile:
                    <OpacityInfoTile Definition="opacityTile" />
                    break;
            }
        }
    </CascadingValue>
    @foreach (var cell in _outline)
    {
        <div class="grid-block-frame" style="@cell.Style()" aria-hidden="true"></div>
    }
    @foreach (var title in _titles)
    {
        <div class="grid-block-title" style="grid-row:@(title.Row + 1); grid-column:@(title.Col + 1) / span @title.Span;" aria-hidden="true">@title.Text</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<GridItemDef> Items { get; set; } = [];

    [Parameter]
    public int Cols { get; set; } = 10;

    [Parameter]
    public int Rows { get; set; } = 7;

    [Parameter]
    public ButtonDisplay Display { get; set; } = ButtonDisplay.Default;

    [Parameter]
    public bool ShowBlockOutline { get; set; } = true;

    private GridOutlineCell[] _outline = [];

    private BlockTitle[] _titles = [];

    protected override void OnParametersSet()
    {
        _outline = ShowBlockOutline ? [.. GridBlockOutline.Build(Items)] : [];
        _titles = [.. Items.Where(i => i.BlockId is not null).GroupBy(i => i.BlockId!).Select(ToTitle)];
    }

    // Anchored at the block's first button, spanning the block width so long names are not cut off.
    private static BlockTitle ToTitle(IGrouping<string, GridItemDef> block)
    {
        var first = block.OrderBy(i => i.Row).ThenBy(i => i.Col).First();
        return new BlockTitle(BlockCatalog.ById[block.Key].Name, first.Row, first.Col, block.Max(i => i.Col) - first.Col + 1);
    }

    private sealed record BlockTitle(string Text, int Row, int Col, int Span);

    // Lets the stylesheet size icon, text and key to the cell for the chosen combination.
    private string DisplayClass => (Display.ShowIcon, Display.ShowText, Display.ShowKey) switch
    {
        (true, false, false) => "only-icon",
        (false, true, false) => "only-text",
        (false, false, true) => "only-key",
        (true, true, true) => "show-all",
        _ => ""
    };
}
