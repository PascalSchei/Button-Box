@implements IDisposable

<div class="grid-item info-tile" style="@TileStyle">
    <span class="info-value">@(Transparency.Percent is { } value ? $"{value} %" : "-")</span>
    @if (Transparency.Error is { } error)
    {
        <span class="btn-label">@error</span>
    }
    else if (Display.ShowText)
    {
        <span class="btn-label">@Definition.Label</span>
    }
</div>

@code {
    [Inject] private WindowTransparencyService Transparency { get; set; } = null!;

    [Parameter, EditorRequired]
    public OpacityInfoTileDef Definition { get; set; } = null!;

    [CascadingParameter]
    public ButtonDisplay Display { get; set; } = ButtonDisplay.Default;

    private string TileStyle => Definition.Style + "color:var(--btn-color, white); background-color:color-mix(in srgb, var(--btn-color, black) 8%, black);";

    protected override void OnInitialized() => Transparency.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Transparency.Changed -= OnChanged;
}
