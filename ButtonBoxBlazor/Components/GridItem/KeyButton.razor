@implements IDisposable
@inject IKeyboardService Keyboard
@inject ControlsStore Controls

<button class="grid-btn grid-item" style="@Definition.Style"
        @onpointerdown="OnDown" @onpointerup="OnUp"
        @onpointerleave="OnUp" @onpointercancel="OnUp">
    @if (ShowIcon)
    {
        <span class="btn-icon" style="--icon-src:url('@Definition.Icon')"></span>
    }
    @if (ShowText)
    {
        <span class="btn-label">@((MarkupString)Definition.Label)</span>
    }
    @if (Display.ShowKey)
    {
        <span class="btn-key">@Controls.Resolve(Definition).Caption</span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public ButtonDef Definition { get; set; } = null!;

    [CascadingParameter]
    public ButtonDisplay Display { get; set; } = ButtonDisplay.Default;

    private readonly ButtonHoldRepeater holdRepeater = new();

    private bool ShowIcon => Display.ShowIcon && Definition.Icon is not null;

    // Falls back to the text when nothing else would be visible (e.g. icon-only without an icon).
    private bool ShowText => Display.ShowText || (!ShowIcon && !Display.ShowKey);

    // Remembered from the press so the release matches even if controls.ini is reloaded while held.
    private string? pressedTag;

    private void OnDown()
    {
        pressedTag ??= Controls.Resolve(Definition).Tag;

        if (Definition.Mode == ButtonMode.Repeat)
        {
            holdRepeater.Start(pressedTag, Keyboard.SendTag);
        }
        else
        {
            Keyboard.SendTagDown(pressedTag);
        }
    }

    private void OnUp()
    {
        if (pressedTag is null)
        {
            return;
        }

        if (Definition.Mode == ButtonMode.Repeat)
        {
            holdRepeater.Stop(pressedTag);
        }
        else
        {
            Keyboard.SendTagUp(pressedTag);
        }

        pressedTag = null;
    }

    public void Dispose() => holdRepeater.Dispose();
}
