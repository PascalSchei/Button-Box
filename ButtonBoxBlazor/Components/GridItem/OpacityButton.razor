@inject WindowTransparencyService Transparency

<button class="grid-btn grid-item" style="@Definition.Style" @onclick="() => Transparency.ChangeOpacity(Definition.Delta)">
    <span class="btn-icon" style="--icon-src:url('@Definition.Icon')"></span>
    <span class="btn-label">@((MarkupString)Definition.Label)</span>
</button>

@code {
    [Parameter, EditorRequired]
    public OpacityButtonDef Definition { get; set; } = null!;
}
